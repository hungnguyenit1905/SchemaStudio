# SwiftFormat configuration
# https://github.com/nicklockwood/SwiftFormat

# Swift version
--swiftversion 5.9

# File options
# LocalPackages holds vendored CodeEdit sources; reformatting them would
# conflict with every upstream update.
--exclude DerivedData,.build,Packages,LocalPackages,Pods,Carthage,vendor

# Format options
--indent 4
--indentcase false
--tabwidth 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions after-first
# The codebase writes `) -> Bool {`; if-multiline breaks it onto its own line.
--wrapreturntype preserve
# Same reason as wrapreturntype: `) async throws {` stays on the closing paren.
--wrapeffects preserve
--closingparen balanced
--funcattributes prev-line
--typeattributes prev-line
--varattributes prev-line
--storedvarattrs same-line
--computedvarattrs same-line

# Spacing
--trimwhitespace always
--linebreaks lf
--semicolons never
--commas always
--operatorfunc spaced
--nospaceoperators
--ranges spaced
--typedelimiter space-after
--guardelse same-line
# The codebase writes `case .foo(let bar)`, not `case let .foo(bar)`.
--patternlet inline
# The codebase writes 1_000 and 250_000_000; the default threshold would strip
# the separators from anything under six digits.
--decimalgrouping 3,4

# Braces
--allman false
--elseposition same-line
--ifdef no-indent

# Misc
--self remove
--selfrequired
--importgrouping alpha
# Never "strip": every file in this repo carries a header comment.
--header ignore
--stripunusedargs closure-only
--emptybraces no-space

# Enabled rules (comment out to disable)
--enable blankLineAfterImports
--enable blockComments
--enable docComments
--enable isEmpty
--enable wrapEnumCases

# Disabled rules
--disable acronyms
--disable redundantSelf
--disable trailingCommas
# CLAUDE.md requires access control to be explicit, including `internal`.
--disable redundantInternal
# CLAUDE.md prescribes early returns, and the codebase writes them on one line
# (`guard x else { return }`). These rules split every one of them.
--disable wrapGuardStatementBodies
--disable wrapIfStatementBodies
--disable wrapPropertyBodies
--disable wrapFunctionBodies
# Puts a lone `{` on its own line after a multiline signature; nothing here does that.
--disable wrapMultilineStatementBraces
# Switch cases here read `case .a: return x`, not the Swift 5.9 implicit-return form.
--disable redundantReturn
# `case .a, .b:` stays on one line throughout the codebase.
--disable wrapSwitchCases
# Keeps the blank line test files put before `@testable import`.
--disable blankLinesBetweenImports
# The codebase assigns with an explicit if/else, not a Swift 5.9 if-expression.
--disable conditionalAssignment
# Renames `testFoo()` to `foo()` in swift-testing suites, which breaks the
# -only-testing filters in CLAUDE.md. A rename, not formatting.
--disable swiftTestingTestCaseNames
# Rewrites `x!` into `try #require(x)` and adds `throws`. That changes what a
# test does, so it belongs in its own reviewed change, not a format pass.
--disable noForceUnwrapInTests
# Broken in SwiftFormat 0.62.1: it drops the init and joins the neighbouring
# declarations onto one line, which will not compile. It is also unsafe here,
# because deleting a public init from a TableProPluginKit transfer struct
# breaks the plugin ABI every shipped plugin links against.
--disable redundantMemberwiseInit
# Rewrites `<T: Encodable>` into `some Encodable`. That is an API signature
# change, and one of them lands on a public TableProPluginKit function where
# CLAUDE.md gates signature edits behind an ABI bump and a plugin re-release.
--disable opaqueGenericParameters
# SwiftLint's modifier_order already owns this and wants `nonisolated private`,
# the opposite of what SwiftFormat produces. One tool per concern.
--disable modifierOrder
# Converting `allSatisfy { $0.x }` to `allSatisfy(\.x)` picks the throwing
# overload of a rethrows method, so the call then needs `try`. Inside a
# `#expect` macro that is a compile error in the test target.
--disable preferKeyPath
# Turns a caseless `struct` namespace into an `enum`. Two of those are public
# TableProPluginKit types, and swapping struct for enum changes the nominal
# type descriptor and drops the implicit init, which breaks every plugin
# binary already linked against them.
--disable enumNamespaces
